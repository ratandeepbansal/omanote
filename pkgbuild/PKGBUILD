# Maintainer: Ratandeep Bansal

pkgname=omanote
pkgver=0.2.2
pkgrel=1
pkgdesc='Markdown notes app with a collapsible notes sidebar, built with Qt Quick, forked from omawrite'
arch=('x86_64')
url='https://github.com/ratandeepbansal/omanote'
license=('MIT' 'OFL-1.1')
install='omanote.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omanote "$pkgdir/usr/bin/omanote"
  /usr/bin/install -Dm755 bin/omanote-pick "$pkgdir/usr/bin/omanote-pick"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omanote.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omanote.svg"
  /usr/bin/install -Dm644 "$startdir/omanote.desktop" "$pkgdir/usr/share/applications/omanote.desktop"
}
